project_id    = "revenueflow-ai-prod"
region        = "southamerica-east1"
image         = "southamerica-east1-docker.pkg.dev/revenueflow-ai-prod/revenueflow/api:REPLACE_WITH_SHA"
min_instances = 1
max_instances = 4
tracer_sink   = "otel"

# Cloud Monitoring email channel for the alert policies (ADR-056). Empty = the
# alerts still exist but do not notify anyone.
# alert_email = "oncall@example.com"

# Optional alert thresholds (defaults shown).
# alert_5xx_ratio              = 0.02
# alert_p95_latency_ms         = 3000   # deliberate early-warning at half the SPEC-035 5s target;
#                                       # the hard turn cap is TURN_BUDGET_S=15s (ADR-057)
# alert_tool_failures_per_hour = 10
# alert_ai_cost_per_hour_usd   = 1.0
# alert_no_turns_minutes       = 15

# Optional: set to enable the budget alert.
# billing_account   = "XXXXXX-XXXXXX-XXXXXX"
# budget_amount_usd = 200

# Read-only Cloud Monitoring dashboard access for teammates (ADR-065). Empty =
# no one but the project's existing IAM members can see the dashboard.
# dashboard_viewer_emails = ["teammate1@example.com", "teammate2@example.com"]

# Custom domain for the landing page (ADR-068). Empty = HTTP-only on the bare
# static IP (ADR-060). After apply, point an A record at output
# landing_page_ip; the managed cert stays PROVISIONING until that resolves.
# landing_domain = "mastavista.com.br"
